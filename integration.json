  "title": "Firecrawl MCP server",
  "description": "Discover a bounded set of site URLs, choose one relevant page, and request its Markdown content. Provider billing, access restrictions and page-level failures remain visible.",
  "status": "ready",
  "verification": "mock-only",
  "releaseEligible": true,
  "maintainer": "jannikco",
