  "attributionSlug": "github-firecrawl-mcp",
  "connectorId": "firecrawl",
  "connector": {
    "id": "firecrawl",
    "name": "Firecrawl",
    "version": "0.1.0",
    "baseUrl": "https://api.firecrawl.dev/v2",
    "auth": {
      "type": "bearer",
      "env": "FIRECRAWL_API_KEY"
    },
    "description": "Map a site and fetch a selected page as Markdown through v2 JSON endpoints. No arbitrary browser actions, binary files or streaming transport is exposed.",
    "tools": [
      {
        "name": "map_site",
        "description": "Discover up to 100 site URLs with a provider-side 10-second timeout.",
        "method": "POST",
        "path": "/map",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^\\s]+$"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {
            "url": "url",
            "limit": "limit"
          }
        },
        "sampleArguments": {
          "url": "https://docs.firecrawl.dev",
          "limit": 10
        },
        "provenance": [
          "https://docs.firecrawl.dev/api-reference/v2-openapi.json"
        ],
        "body": {
          "timeout": 10000
        }
      },
      {
        "name": "scrape_page",
        "description": "Fetch a selected URL as Markdown with a 10-second provider timeout. Check success and returned data rather than assuming complete site extraction.",
        "method": "POST",
        "path": "/scrape",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^\\s]+$"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {
            "url": "url"
          }
        },
        "sampleArguments": {
          "url": "https://docs.firecrawl.dev/introduction"
        },
        "provenance": [
          "https://docs.firecrawl.dev/api-reference/v2-openapi.json"
        ],
        "body": {
          "formats": [
            "markdown"
          ],
          "timeout": 10000
        }
      }
    ],
    "provenance": [
      "https://docs.firecrawl.dev/api-reference/v2-openapi.json"
    ],
    "sourceEvidence": [
      {
        "url": "https://docs.firecrawl.dev/api-reference/v2-openapi.json",
