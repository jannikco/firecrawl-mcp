  "appSlug": "firecrawl",
  "appName": "Firecrawl",
  "operationIds": [
    "map_site",
    "scrape_page"
  ],
  "sourceRevision": "f77ff04804f59551d6bb6e19a4bd061309b9ea8ced3c944e19d7558efae8f742",
  "evidence": [
