{
  "openapi": "3.1.0",
  "info": {
    "title": "Firecrawl selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.firecrawl.dev/v2"
    }
  ],
  "paths": {
    "/map": {
      "post": {
        "operationId": "map_site",
        "summary": "Discover up to 100 site URLs with a provider-side 10-second timeout.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^https://[^\\s]+$"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "timeout": {
                    "const": 10000,
                    "default": 10000
                  }
                },
                "required": [
                  "url",
                  "timeout"
                ]
              }
            }
          }
        }
      }
    },
    "/scrape": {
      "post": {
        "operationId": "scrape_page",
        "summary": "Fetch a selected URL as Markdown with a 10-second provider timeout. Check success and returned data rather than assuming complete site extraction.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^https://[^\\s]+$"
                  },
                  "formats": {
                    "const": [
                      "markdown"
                    ],
                    "default": [
                      "markdown"
                    ]
                  },
                  "timeout": {
                    "const": 10000,
                    "default": 10000
                  }
                },
                "required": [
                  "url",
                  "formats",
                  "timeout"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
